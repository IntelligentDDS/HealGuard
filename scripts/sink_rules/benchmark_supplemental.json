{
  "version": 1,
  "source": "project_supplement",
  "policy": "项目补充的操作候选，不属于 Bandit；必须确认真实目标、持久化副作用及 Heal Source 参数依赖，不能直接作为标签。",
  "rules": [
    {"rule_id":"PROJECT.FILE.open","callees":["builtins.open","io.open"],"sink_kind":"FILESYSTEM","argument":0,"critical_arguments":["file","mode"],"operation":"file_open_write","mode_position":1,"mode_default":"r","requirement":"只有 w/a/x/+ 模式进入写入候选；r+ 打开本身不证明写入，仍需后续实际写操作。"},
    {"rule_id":"PROJECT.FILE.os_open","callees":["os.open"],"sink_kind":"FILESYSTEM","argument":0,"critical_arguments":["path","flags","mode"],"operation":"file_open_flags","requirement":"核实 flags 中写入、创建或截断标志；只读打开排除，未知 flags 待核实。"},
    {"rule_id":"PROJECT.FILE.path_open","callees":["pathlib.Path.open"],"method_names":["open"],"sink_kind":"FILESYSTEM","argument":0,"critical_arguments":["receiver_path","mode"],"operation":"file_open_write","mode_position":0,"mode_default":"r","requirement":"必须确认 receiver 为 pathlib 路径，实际文件路径在 receiver；不能把 mode 当路径。"},
    {"rule_id":"PROJECT.FILE.stream_write","callees":["io.TextIOBase.write","io.BufferedIOBase.write","io.RawIOBase.write"],"method_names":["write","writelines"],"sink_kind":"FILESYSTEM","argument":0,"critical_arguments":["receiver_file","data_or_lines"],"operation":"file_write","requirement":"必须确认 receiver 为真实文件且发生写入；排除 StringIO/BytesIO、socket 和 HTTP 响应等同名方法。"},
    {"rule_id":"PROJECT.FILE.path_write","callees":["pathlib.Path.write_text","pathlib.Path.write_bytes"],"method_names":["write_text","write_bytes"],"sink_kind":"FILESYSTEM","argument":0,"critical_arguments":["receiver_path","data"],"operation":"file_write","requirement":"确认 pathlib receiver；路径由 receiver 提供，内容为 data；自定义同名方法不自动认定。"},
    {"rule_id":"PROJECT.FILE.os_write","callees":["os.write","os.pwrite","os.writev"],"sink_kind":"FILESYSTEM","argument":1,"critical_arguments":["fd","data_or_buffers","offset"],"operation":"file_write","requirement":"fd 必须解析为真实文件，不能把管道或 socket 写入计为文件写入。"},
    {"rule_id":"PROJECT.FILE.remove","callees":["os.remove","os.unlink","os.rmdir","shutil.rmtree"],"sink_kind":"FILESYSTEM","argument":0,"critical_arguments":["path","dir_fd"],"operation":"file_delete","requirement":"核实实际目标及成功删除；忽略错误或不存在路径不能证明已发生删除。"},
    {"rule_id":"PROJECT.FILE.path_remove","callees":["pathlib.Path.unlink","pathlib.Path.rmdir"],"method_names":["unlink","rmdir"],"sink_kind":"FILESYSTEM","argument":"receiver","critical_arguments":["receiver_path"],"operation":"file_delete","requirement":"目标路径在 receiver，通常没有路径参数；当前仅替换 call argument 的 Safe 构造不支持 receiver-only 案例。"},
    {"rule_id":"PROJECT.DB.execute","callees":["sqlite3.Cursor.execute","sqlite3.Cursor.executemany","sqlite3.Cursor.executescript","sqlite3.Connection.execute","sqlite3.Connection.executemany","sqlite3.Connection.executescript"],"method_names":["execute","executemany","executescript"],"sink_kind":"DATABASE","argument":0,"critical_arguments":["sql_or_statement","parameters","receiver_connection"],"operation":"database_execute","requirement":"覆盖 DB-API/SQLAlchemy 等实际执行入口候选；必须解析驱动及完整语句，证实写入及事务效果；普通 SELECT/查询构造不入标签。"},
    {"rule_id":"PROJECT.DB.orm_update","callees":["django.db.models.query.QuerySet.update","django.db.models.query.QuerySet.bulk_update"],"method_names":["update","bulk_update"],"sink_kind":"DATABASE","argument":"all","critical_arguments":["updated_fields","objects","receiver_query_conditions"],"operation":"database_orm_write","requirement":"确认 ORM 写入 receiver 和实际数据库执行；dict.update、SQLAlchemy update 语句构造不是写数据库。"},
    {"rule_id":"PROJECT.DB.orm_create","callees":["django.db.models.query.QuerySet.create","django.db.models.query.QuerySet.bulk_create","django.db.models.query.QuerySet.get_or_create","django.db.models.query.QuerySet.update_or_create"],"method_names":["create","bulk_create","get_or_create","update_or_create"],"sink_kind":"DATABASE","argument":"all","critical_arguments":["fields","objects","defaults","receiver_model"],"operation":"database_orm_write","requirement":"确认 ORM 和实际创建/修改；get_or_create 仅读取现有记录的分支不算写入。"},
    {"rule_id":"PROJECT.DB.orm_delete","callees":["django.db.models.query.QuerySet.delete","django.db.models.base.Model.delete"],"method_names":["delete"],"sink_kind":"DATABASE","argument":"receiver","critical_arguments":["receiver_query_conditions","receiver_object"],"operation":"database_orm_write","requirement":"确认 ORM 及实际数据库删除；延迟删除必须追踪 flush/commit，receiver-only 案例不能直接交给参数替换构造。"},
    {"rule_id":"PROJECT.DB.orm_save","callees":["django.db.models.base.Model.save"],"method_names":["save"],"sink_kind":"DATABASE","argument":"receiver","critical_arguments":["receiver_fields","update_fields"],"operation":"database_orm_write","requirement":"确认 ORM 模型和实际 INSERT/UPDATE；图像保存等同名方法不是数据库操作；真实字段来源通常在 receiver。"}
  ]
}
